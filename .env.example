# Copy this file to .env.local (git-ignored) and fill in your own values.
# Only the public anon key belongs here. Never put a Supabase service-role key in any env file.

# Supabase project URL and public anon key (Supabase dashboard > Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of the deployed site, no trailing slash. Used for auth redirects, canonical links, sitemap and Open Graph tags.
VITE_SITE_URL=http://localhost:5173

# Set to true only after Google sign-in is configured in Supabase.
VITE_ENABLE_GOOGLE=false

# Contact address shown on the Privacy page. Leave empty until the owner chooses one.
VITE_CONTACT_EMAIL=
